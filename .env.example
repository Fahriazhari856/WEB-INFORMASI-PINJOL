# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Database: `sqlite` untuk lokal/fallback, `postgres` untuk Supabase.
# Jika dikosongkan, adanya DATABASE_URL/SUPABASE_DB_URL akan memilih Postgres otomatis.
DB_DRIVER=postgres
DB_PATH=./data/cekpinjol.sqlite

# Supabase Postgres. DB_DRIVER eksplisit tetap menjadi sumber pilihan utama.
# Salin connection string dari Dashboard Supabase > Connect. Jangan commit nilainya.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
# SUPABASE_DB_URL= dapat dipakai sebagai fallback jika DATABASE_URL tidak diisi.
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000

# Direkomendasikan: verify-full + CA resmi yang diunduh dari Database Settings.
# `require` tetap terenkripsi tetapi tidak memverifikasi identitas server sepenuhnya.
PGSSL_MODE=verify-full
SUPABASE_DB_CA_PATH=

# Wajib berupa nilai acak panjang pada production. Simpan melalui secret manager.
CSRF_SECRET=

# Hanya dibutuhkan oleh `npm run create-admin` pada lingkungan non-interaktif.
# Jangan commit nilai sebenarnya.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
